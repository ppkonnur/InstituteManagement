# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret

# PostgreSQL connection string format:
# postgresql+psycopg://username:password@127.0.0.1:5432/database_name?connect_timeout=3
#DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/institute_db?connect_timeout=3
DATABASE_URL=sqlite:///institute.db
# Default admin account for first-time setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
